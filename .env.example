# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_CHAIN_ID=296
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=0x...

# Merchant (x402 payee)
MERCHANT_ACCOUNT_ID=0.0.xxxxx
MERCHANT_KEY=0x...

# USDC on Hedera testnet
USDC_TOKEN_ID=0.0.xxxxx
USDC_EVM_ADDRESS=0x...

# x402
X402_FACILITATOR_URL=https://...
X402_NETWORK=hedera-testnet

# Demo accounts (<PREFIX>_ID/_KEY/_EVM for SELLER, BUYER, WORKER_*, LENDER_*, COORDINATOR,
# COSIGNER, KYA_ISSUER) live in .env.accounts, written by `pnpm tsx scripts/setup-accounts.ts`.
# Do not set them here: .env takes precedence over .env.accounts.

# Added by later tasks
HCS_AUDIT_TOPIC_ID=0.0.xxxxx
# Agents' own notes (hedera-agent-kit submit_topic_message): an HCS topic WITHOUT a submit key (the audit topic only accepts the operator's key)
AGENT_NOTES_TOPIC_ID=
RECEIVABLE_NFT_TOKEN_ID=0.0.xxxxx
MCP_RESOURCE_URL=http://localhost:4030/mcp
AUTH_ISSUER=http://localhost:4020
MCP_PORT=4030
AUTH_PORT=4020
MERCHANT_PORT=3003
# Interface the auth and MCP servers bind to (default 127.0.0.1, loopback only)
HOST=
# Demo only: serve the authorization-code + PKCE grant (dynamic registration, consent page) for human MCP
# clients such as Claude Code (docs/CLAUDE_CODE_DEMO.md). Off by default; never enable it on a public host.
AUTH_DEMO_GRANT=false

# Optional
ANTHROPIC_API_KEY=
SKYFIRE_JWKS_ISSUER=
# MCP server (docs/API.md): browser origins allowed to read the read API, comma-separated
CORS_ORIGINS=http://localhost:3000
# MCP server data (events.jsonl, idempotency.json, pending.json, invoices/); default apps/mcp-server/data
DATA_DIR=
# Invoice documents: also copy them to the Hedera File Service (operator pays)
HFS_ENABLED=false
# Invoice field extraction: heuristic by default; ollama uses a local model (unset = use it if Ollama answers)
CASHETH_LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
CASHETH_LLM_MODEL=qwen2.5:7b
# Demo only: let the MCP server sign as the lender agents (fund_agents, close_strategy) and as the
# seller/buyer/worker agents (set_budgets, repay_receivable, pay_x402) with their .env.accounts keys.
# AGENT_KEYS_IN_PROCESS also takes a role list, e.g. seller,worker (the buyer then repays from its own wallet)
LENDER_KEYS_IN_PROCESS=false
AGENT_KEYS_IN_PROCESS=false
# First block to scan for Aqua Shipped/Docked logs (default: the swap router's creation block)
AQUA_FROM_BLOCK=
# The only URL origins pay_x402 may fetch, per merchant account: accountId=origin pairs, comma-separated, added to
# the demo merchant (MERCHANT_ACCOUNT_ID=http://localhost:$MERCHANT_PORT, always admitted). External merchant example:
# MERCHANT_ORIGINS=0.0.11333304=https://casheth-paid-apis-177290233934.asia-southeast1.run.app
MERCHANT_ORIGINS=
