# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_CHAIN_ID=296
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=0x...

# Merchant (x402 payee)
MERCHANT_ACCOUNT_ID=0.0.xxxxx
MERCHANT_KEY=0x...

# USDC on Hedera testnet
USDC_TOKEN_ID=0.0.xxxxx
USDC_EVM_ADDRESS=0x...

# x402
X402_FACILITATOR_URL=https://...
X402_NETWORK=hedera-testnet

# Demo accounts (<PREFIX>_ID/_KEY/_EVM for SELLER, BUYER, WORKER_*, LENDER_*, COORDINATOR,
# COSIGNER, KYA_ISSUER) live in .env.accounts, written by `pnpm tsx scripts/setup-accounts.ts`.
# Do not set them here: .env takes precedence over .env.accounts.

# Added by later tasks
HCS_AUDIT_TOPIC_ID=0.0.xxxxx
RECEIVABLE_NFT_TOKEN_ID=0.0.xxxxx
MCP_RESOURCE_URL=http://localhost:4030/mcp
AUTH_ISSUER=http://localhost:4020
MCP_PORT=4030
AUTH_PORT=4020
MERCHANT_PORT=3003

# Optional
ANTHROPIC_API_KEY=
SKYFIRE_JWKS_ISSUER=
# MCP server (docs/API.md): browser origins allowed to read the read API, comma-separated
CORS_ORIGINS=http://localhost:3000
# MCP server data (events.jsonl, idempotency.json, pending.json); default apps/mcp-server/data
DATA_DIR=
# Demo only: let the MCP server sign as the lender agents (fund_agents, close_strategy) and as the
# seller/buyer/worker agents (set_budgets, repay_receivable, pay_x402) with their .env.accounts keys
LENDER_KEYS_IN_PROCESS=false
AGENT_KEYS_IN_PROCESS=false
# First block to scan for Aqua Shipped/Docked logs (default: the swap router's creation block)
AQUA_FROM_BLOCK=
