{
  "name": "casheth-paid-apis",
  "version": "0.2.0",
  "private": true,
  "description": "Demo pay-per-call APIs for CashETH. Each endpoint is paywalled with x402 and paid in USDC on Hedera testnet.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "pay": "node --env-file-if-exists=.env scripts/pay.mjs"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/hedera": "2.28.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@x402/fetch": "2.28.0"
  }
}
