# ---------- Server ----------
PORT=8080

# Merchant account that receives payments. It must be associated with USDC.
PAY_TO=0.0.123456

# Optional second account for /premium-data (the "unapproved payee" demo).
# Leave empty to hide that endpoint.
ROGUE_PAY_TO=

X402_NETWORK=hedera:testnet
PAYMENT_ASSET=0.0.429274
PAYMENT_ASSET_DECIMALS=6

# Any facilitator that supports hedera:testnet:
#   https://x402.org/facilitator
#   https://api.testnet.blocky402.com
#   https://testnet.facilitator.launa.dev
FACILITATOR_URL=https://x402.org/facilitator

# Prices in USD (plain numbers), paid in USDC.
PRICE_PRICE_FEED=0.50
PRICE_WEB_SCRAPE=1.00
PRICE_LLM_SUMMARY=2.00
PRICE_PREMIUM_DATA=5.00

# true = serve everything for free (UI work without a wallet)
PAYWALL_DISABLED=false

# ---------- Test client (npm run pay) ----------
API_URL=http://localhost:8080
PAYER_ACCOUNT_ID=0.0.654321
# ECDSA private key, 0x-prefixed hex (from portal.hedera.com)
PAYER_PRIVATE_KEY=0x...
# Client guardrails: max USD per single payment, and (optional) allowed payees
MAX_PAYMENT_USD=5
ALLOWED_PAY_TO=
