    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "0.4.0",
    "@casheth/agents": "workspace:*",
    "@casheth/hedera": "workspace:*",
    "@casheth/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  }
